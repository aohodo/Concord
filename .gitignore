# Secrets and local configuration
**/.env
!**/.env.example

# Private local documentation (never publish)
/docs/
/文档+简历/

# Python
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/venv/
**/.pytest_cache/
/.pytest-tmp/

# Node.js
**/node_modules/
**/dist/

# Java and Maven
**/target/
**/.mvn/apache-maven-*/
**/.mvn/apache-maven-*-bin.zip

# Runtime data
**/data/
**/logs/
**/*.sqlite3
**/*.log

