        "verification_targets": ["dependency.routing", "service.status"]
      }
    ],
    "goal": "优先恢复服务可用性",
    "success_criteria": ["service.status=healthy"],
    "tags": ["intermittent_signal", "mitigation_first", "deadline"],
    "expected": {
      "allowed_statuses": ["resolved"],
      "required_decision_events": ["verification_complete"],
      "required_verification_targets": ["dependency.routing", "service.status"],
      "max_model_calls": 4
    }
  },
