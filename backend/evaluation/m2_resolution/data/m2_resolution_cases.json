  {
    "scenario_id": "vpn_stale_credential",
    "domain": "enterprise_it",
    "title": "域密码变更后的 VPN 认证失败",
    "user_report": "内网那个东西又连不上了，网页能开，刚改过密码，已经重启很多次。",
    "user_hypothesis": "可能是公司 DNS 坏了。",
    "urgency": "deadline",
    "explanation_preference": "minimal",
    "visible_state": {
      "vpn": "authentication_failed",
      "access": "blocked",
      "public_network": "reachable",
      "client_note": "error 691; cached profile age unknown"
    },
    "hidden_state": {"root_cause": "stale_credential"},
    "action_rules": [
      {
        "action_id": "refresh_credential",
        "description": "刷新本地认证凭据并重新建立会话",
        "preconditions": [{"path": "vpn", "value": "authentication_failed"}],
        "effects": [
          {"path": "vpn", "value": "connected"},
          {"path": "access", "value": "restored"}
        ],
        "success_observation": "凭据刷新请求已执行",
        "verification_targets": ["vpn", "access"]
      }
    ],
    "goal": "尽快恢复内网访问",
    "success_criteria": ["access=restored"],
    "tags": ["dirty_report", "wrong_hypothesis", "deadline"],
    "expected": {
      "allowed_statuses": ["resolved"],
      "required_decision_events": ["bootstrap_complete", "verification_complete"],
      "required_verification_targets": ["vpn", "access"],
      "max_model_calls": 4
    }
  },
