APP_ENV=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

# anthropic 或 openai；OpenAI-compatible 千问使用 openai
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=300

# 阿里云百炼 OpenAI-compatible 接口
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-flash
OPENAI_REASONING_EFFORT=low

# Anthropic provider 配置（LLM_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=your_api_key
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

REDIS_URL=redis://:concord-local-only@localhost:6379/0
REDIS_PASSWORD=concord-local-only
CONCORD_REQUIRE_REDIS=false

RETRIEVAL_INDEX_PATH=./data/retrieval

# LangGraph 跨轮 checkpoint 与可回放策略轨迹（本地运行数据，不提交 Git）
CONCORD_GRAPH_DB=./data/concord_graph.sqlite3
CONCORD_RUNTIME_DB=./data/concord_runtime.sqlite3
CONCORD_CASE_EVENT_DB=./data/case_events.sqlite3
CONCORD_AGENT_PERFORMANCE_DB=./data/agent_performance.sqlite3
CONCORD_ENABLE_MANUAL_COLLABORATION_FEEDBACK=false
CONCORD_FORMULATION_TRACE=./data/traces/problem_formulation.jsonl
CONCORD_TOOL_AUDIT_LOG=./data/traces/tool_audit.jsonl
CONCORD_JOB_POLL_SECONDS=0.5
CONCORD_JOB_LEASE_SECONDS=180

# LangSmith 默认关闭。启用后仍默认隐藏输入/输出正文，并禁止继承代理环境。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=concord-dev-synthetic
LANGSMITH_ENDPOINT=
CONCORD_LANGSMITH_INCLUDE_CONTENT=false
CONCORD_LANGSMITH_TRUST_ENV_PROXY=false

MONITOR_INTERVAL=60
PROMETHEUS_PORT=9090
ALERT_WEBHOOK_URL=
# Evaluation-only ablation routes are disabled in normal service operation.
CONCORD_ENABLE_EVALUATION_VARIANTS=false
